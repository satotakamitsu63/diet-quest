{
  "name": "diet-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/verify.mjs && node node_modules/.cache/verify.mjs",
    "understand": "esbuild scripts/check-understanding.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/understand.mjs && node node_modules/.cache/understand.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}